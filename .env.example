# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Your bucket's region, e.g. us-west-004 / us-east-005 / eu-central-003.
# The S3 endpoint is derived from it: https://s3.<B2_REGION>.backblazeb2.com
B2_REGION=your_region

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=<the secret shown once when you created the key>
# B2_BUCKET_NAME=my-photo-library
# B2_REGION=us-west-004

# Optional: base URL for building public object links (public buckets only).
# The app serves everything via presigned URLs and runs fine without this.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Optional: force the on-device CLIP layer onto a device. Empty = autodetect
# (CUDA -> Apple MPS -> CPU, defaulting to CPU). Values: cpu | cuda | mps
# ML_DEVICE=

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
